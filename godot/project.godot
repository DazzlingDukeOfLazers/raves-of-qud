; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

; config/name is the editor/export project name. The RUNTIME source of truth for the
; game name is Brand.GAME_NAME (autoload below); MainMenu stamps the window title from
; it on launch, so a rename only needs Brand.gd (+ this literal, which Godot requires).
config/name="Raves of Qud"
run/main_scene="res://MainMenu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Brand="*res://Brand.gd"
Settings="*res://Settings.gd"
QudLauncher="*res://QudLauncher.gd"
UiState="*res://UiState.gd"
FeedbackTool="*res://FeedbackTool.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/dpi/allow_hidpi=false

[rendering]

textures/vram_compression/import_etc2_astc=true

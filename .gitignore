# Godot 4
godot/.godot/
godot/*.translation
godot/export_presets.cfg
godot/.import/

# .NET build output (the csproj is a dev-time type-check harness only)
mod/bin/
mod/obj/
tools/tiletool/bin/
tools/tiletool/obj/

# Never commit Qud's assets or binaries — this project ships none.
# Point the client at your own local install at runtime instead.
assets/qud/
*.dll

# ...AND NEVER A WINDOW CAPTURE OF IT EITHER. Six Qud screenshots were swept into a
# commit by `git add -A` on 2026-08-10: a capture loop ran with its cwd drifted to the
# repo root (the same drift that has silently skipped a build twice), dropped q1..q6.png
# here, and the next commit took them. Screenshots belong in the session scratchpad, or
# in reports/ when they are the deliverable. Rooted so it cannot reach reports/ or godot/.
/*.png

# Python (the capture tools are stdlib scripts; never commit bytecode)
__pycache__/
*.pyc

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/
build/

# highvisor regression run output (captures + diffs)
tools/regression/_regress/

# Full-frame checker captures are per-run scratch (GBs) — evidence/ carries the
# committed crops for flagged elements; calibrate regenerates the rest.
reports/checker/shots/
